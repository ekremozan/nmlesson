<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Platform theme. Compose draws the whole UI, so this only governs the window itself.
      The framework has no Material.DayNight parent below API 29, so the dark variant lives in
      values-night/themes.xml rather than in a single DayNight parent.
    -->
    <style name="Theme.NativeMinds" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nm_window_background</item>
    </style>

    <!--
      Shown from process start until MainActivityViewModel confirms the local lesson cache matches
      the current content language — see MainActivity.setKeepOnScreenCondition. postSplashScreenTheme
      hands the window straight to Theme.NativeMinds once the platform dismisses this one.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nm_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NativeMinds</item>
    </style>
</resources>
