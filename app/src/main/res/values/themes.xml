<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Platform theme. Compose draws the whole UI, so this only governs the window itself.
      The framework has no Material.DayNight parent below API 29, so the dark variant lives in
      values-night/themes.xml rather than in a single DayNight parent.
    -->
    <style name="Theme.NativeMinds" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nm_window_background</item>
    </style>
</resources>
