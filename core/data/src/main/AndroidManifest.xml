<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Declared by the module that actually uses it (NetworkMonitor), not by :app. The manifest
        merger folds it into the final app manifest, and lint can verify the call site against the
        permission without depending on what a consumer happens to declare.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
